# ── Database ───────────────────────────────────────────────────────────────
# Local development:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
#
# Supabase (Project Settings → Database → Connection string):
#  • APP RUNTIME (serverless — transaction pooler, port 6543):
#    DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
#  • MIGRATIONS / drizzle-kit push (session or direct, port 5432):
#    DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
#    # or: postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
#
# The runtime client is postgres.js with prepare:false (required by the
# Supavisor/PgBouncer transaction pooler) and TLS auto-enabled for remote
# hosts. The schema also auto-bootstraps at server startup (see /api/bootstrap).

# ── GenLayer Studio network (chain 61999) ──────────────────────────────────
GENLAYER_CHAIN_ID=61999
GENLAYER_RPC_URL=https://studio.genlayer.com/api

# Deployed AEGIS Intelligent Contract (see deployments.json):
AEGIS_CONTRACT_ADDRESS=0x210Dcf0aAa76FEDD00fEc7bc00243e1539FC0A22
# Exposed to the browser (dApp footer chip):
NEXT_PUBLIC_AEGIS_CONTRACT_ADDRESS=0x210Dcf0aAa76FEDD00fEc7bc00243e1539FC0A22

# ── Live E2E acceptance run (scripts/e2e-live.mjs) ─────────────────────────
GENLAYER_PRIVATE_KEY=
GENLAYER_RESPONDENT_PRIVATE_KEY=
EVIDENCE_URL=

# ── Optional: real LLM arbitration (OpenAI-compatible chat completions) ────
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
